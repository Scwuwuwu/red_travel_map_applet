/* 顶部导航栏样式 */
.top-bar {
  width: 100%;
  height: 80rpx;
  position: relative;
}

.cityBar {
  white-space: nowrap;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.cityItem {
  display: inline-block;
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: white;
}

.cityItem.active {
  font-weight: bold;
  position: relative;
}

.cityItem.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: white;
}

/* 地图区域样式 */
.map-area {
  flex: 1;
  width: 100%;
}

/* 景点列表样式 */
.attraction-container {
  background: white;
  max-height: 50vh;
}

.toggle-bar {
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  border-bottom: 1px solid #f5f5f5;
}

.red-text {
  color: #940700;
}

.attraction-scroll {
  max-height: calc(50vh - 60rpx);
}

.attraction-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1px solid #f5f5f5;
}

.attraction-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.attraction-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-left: 20rpx;
}

.attraction-name {
  font-size: 28rpx;
  color: #333;
}

.action-buttons {
  display: flex;
  align-items: center;
}

.location-btn, .guide-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}
